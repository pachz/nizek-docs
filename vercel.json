{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/generate.ts": {
      "maxDuration": 60
    },
    "api/generate/prompt.ts": {
      "maxDuration": 10
    },
    "api/generate/parse.ts": {
      "maxDuration": 10
    }
  }
}
